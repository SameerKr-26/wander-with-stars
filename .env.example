# ---------------------------------------------------------------------------
# Wander With Stars — environment template
#
# Copy this file to .env.local and fill in real values:
#
#     cp .env.example .env.local          (PowerShell: copy .env.example .env.local)
#
# .env.local is gitignored and MUST NEVER be committed.
# Use a DEVELOPMENT Supabase project here — never production credentials.
# ---------------------------------------------------------------------------

# --- Public (safe to expose — inlined into the browser bundle) ---------------

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → anon / public
# Safe in the browser: it only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of this environment. Used for auth redirects, canonical URLs and
# Open Graph metadata. Local development uses http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Secret (server-only — NEVER prefix these with NEXT_PUBLIC_) -------------

# Supabase → Project Settings → API Keys → service_role  (click "Reveal")
#
# ⚠️  BYPASSES ROW LEVEL SECURITY. Treat as a database admin password.
#     Never commit it, never send it to the browser, never paste it in chat.
#     If it leaks, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# --- Supabase CLI (optional, not read by the app) ----------------------------

# Supabase → Project Settings → General → Reference ID
#
# Recorded here for convenience only. The CLI does not read this file: link the
# project once, and it remembers the ref in supabase/.temp (gitignored):
#
#     npx supabase login
#     npx supabase link --project-ref your-project-ref
#
# After linking, `npm run db:types` and `npm run db:push` work without it.
SUPABASE_PROJECT_ID=your-project-ref


# --- Content source (Phase 4.2, optional) ------------------------------------

# lib/content/queries.ts reads published trip content from fixtures by
# default. Set to "database" only once the Phase 4.1 schema
# (supabase/migrations/) has actually been applied to the project above —
# see lib/content/db/source.ts for the full explanation.
# CONTENT_SOURCE=database


# --- Razorpay (Phase 4.7, optional — only needed to test the payment flow) ---
#
# TEST/sandbox keys only. Razorpay Dashboard → Settings → API Keys, with
# "Test Mode" toggled on (top-right) — never generate or paste LIVE keys
# here. Lazily validated (lib/payments/env.ts): the rest of the app runs
# fine without these; only an actual payment attempt requires them.

# Razorpay Dashboard → Settings → API Keys → Test Mode → Key ID
# Not secret on its own, but kept server-side here too because the server
# also authenticates its own Orders/Payments API calls with it.
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay Dashboard → Settings → API Keys → Test Mode → Key Secret
# ⚠️  Server-only. Never send to the browser.
RAZORPAY_KEY_SECRET=your_key_secret

# Razorpay Dashboard → Settings → Webhooks → (create one, Test Mode) →
# Secret. Used only to verify that a webhook delivery genuinely came from
# Razorpay (lib/payments/webhook.ts) — see docs/ARCHITECTURE.md's Phase
# 4.7 section for the local-testing workflow (ngrok + this dashboard, or a
# direct signed POST for automated tests).
# ⚠️  Server-only. Never send to the browser.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
