# Normalise line endings: LF in the repository, native in the working tree.
# Prevents Windows CRLF noise in diffs and CI.
* text=auto eol=lf

# Explicitly text
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.toml      text eol=lf
.env.example text eol=lf

# Windows-only scripts keep CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary — never diff or normalise
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.avif      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.mp4       binary
*.webm      binary
*.pdf       binary

# Collapse lockfile noise in pull requests
package-lock.json linguist-generated=true -diff
